{
    "apiVersion": 3,
    "name": "kit/framework-fixture",
    "title": "Framework Fixture",
    "category": "kit",
    "icon": "layout",
    "description": "End-to-end fixture proving the block framework: padding, entrance, ground and the cta/divider helpers.",
    "textdomain": "kit",
    "render": "file:./block.php",
    "supports": {
        "anchor": true
    },
    "attributes": {
        "heading": { "type": "string", "default": "" },
        "ground": { "type": "string", "default": "" },
        "sectionDivider": { "type": "string", "default": "none" },
        "ctaText": { "type": "string", "default": "" },
        "ctaLink": { "type": "object", "default": { "url": "", "opensInNewTab": false } },
        "ctaIcon": { "type": "string", "default": "" },
        "ctaIconPosition": { "type": "string", "default": "" },
        "items": { "type": "array", "default": [] },
        "entrance": {
            "type": "object",
            "default": {
                "type": "fade-slide",
                "direction": "up",
                "distance": null,
                "unit": "px",
                "duration": null,
                "delay": null,
                "stagger": null,
                "trigger": "section"
            }
        }
    }
}
