        "ground": {
            "type": "string",
            "default": ""
        },
        "sectionDivider": {
            "type": "string",
            "default": "none"
        },
        "ctaText": {
            "type": "string",
            "default": ""
        },
        "ctaLink": {
            "type": "object",
            "default": {
                "url": "",
                "opensInNewTab": false
            }
        },
        "ctaIcon": {
            "type": "string",
            "default": "none"
        },
        "ctaIconPosition": {
            "type": "string",
            "default": "after"
        },
        "paddingVertDesktop": {
            "type": "number",
            "default": 112
        },
        "paddingVertMobile": {
            "type": "number",
            "default": 56
        },
        "paddingXDesktop": {
            "type": "boolean",
            "default": true
        },
        "paddingXMobile": {
            "type": "boolean",
            "default": true
        }
