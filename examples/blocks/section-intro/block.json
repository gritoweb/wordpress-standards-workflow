            "default": ""
        },
        "body": {
            "type": "string",
            "default": ""
        },
        "align": {
            "type": "string",
            "default": "center"
        },
        "measure": {
            "type": "string",
            "default": "default"
        },
        "bodyScale": {
            "type": "string",
