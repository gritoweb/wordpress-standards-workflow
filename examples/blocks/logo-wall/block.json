{
    "apiVersion": 3,
    "name": "__BLOCK_NAMESPACE__/logo-wall",
    "title": "Logo wall",
    "category": "__BLOCK_CATEGORY_SLUG__",
    "icon": "screenoptions",
    "description": "Client or partner logos in centered rows on a ground, with an optional heading and a read-more link.",
    "textdomain": "__TEXT_DOMAIN__",
    "render": "file:./block.php",
    "viewStyle": "file:./block.css",
    "supports": {
        "anchor": true
    },
    "attributes": {
        "isPreview": {
            "type": "boolean",
            "default": false
        },
        "paddingVertDesktop": {
            "type": "number",
            "default": 112
        },
        "paddingVertMobile": {
            "type": "number",
            "default": 56
        },
        "paddingXDesktop": {
            "type": "boolean",
            "default": false
        },
        "paddingXMobile": {
            "type": "boolean",
            "default": false
        },
        "heading": {
            "type": "string",
            "default": ""
        },
        "logos": {
            "type": "array",
            "default": []
        },
        "ground": {
            "type": "string",
            "default": ""
        },
        "sectionDivider": {
            "type": "string",
            "default": "none"
        },
        "ctaText": {
            "type": "string",
            "default": ""
        },
        "ctaLink": {
            "type": "object",
            "default": { "url": "", "opensInNewTab": false }
        },
        "entrance": {
            "type": "object",
            "default": {
                "type": "fade",
                "direction": "up",
                "distance": null,
                "unit": "px",
                "duration": null,
                "delay": null,
                "stagger": 60,
                "trigger": "section"
            }
        }
    },
    "example": {
        "attributes": {
            "isPreview": true
        }
    }
}
