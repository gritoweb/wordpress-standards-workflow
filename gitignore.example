# --- GritoWeb base .gitignore (WordPress standard + Sage 11 + Lando) ---
# Adjust per project. On Pantheon, the upstream may already track core/config;
# do NOT blindly override an existing repo's .gitignore — merge intentionally.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Lando (keep .lando.yml in git; ignore local-only overrides)
.lando.local.yml
.lando/

# WordPress runtime
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/blogs.dir/
*.log

# Secrets / local config
.env
.env.*
!.env.example
wp-config-local.php

# --- Sage 11 theme (wp-content/themes/<theme>/) ---
# On the plain Pantheon upstream this kit targets (WP core committed, no
# build_step) the platform serves exactly what's pushed — nothing runs
# `composer install` or `pnpm build` on deploy. So the theme's compiled deps
# MUST be committed, or the deployed site white-screens: Sage's functions.php
# wp_die()s without vendor/autoload.php, and a missing public/build/ means no
# CSS/JS. That's why vendor/ and public/build/ are NOT ignored here.
# Sage ships its own wp-content/themes/<theme>/.gitignore that DOES ignore both
# — drop those two lines from it after scaffolding (see README › Deploying to
# Pantheon). If you instead adopt Integrated Composer + Build Tools, invert
# this (ignore them; the platform rebuilds on deploy) — again, see the README.
wp-content/themes/*/node_modules/
wp-content/themes/*/public/hot
wp-content/themes/*/dist/
wp-content/themes/*/.env

# Composer (root, if used)
/vendor/
